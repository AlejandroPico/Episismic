{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Episismic",
  "version": "1.1.0",
  "identifier": "com.alejandropico.episismic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Episismic · Observatorio geofísico mundial",
        "width": 1440,
        "height": 900,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Observatorio sísmico mundial en un globo 3D",
    "longDescription": "Episismic integra terremotos, estaciones FDSN, volcanes y tectónica en una aplicación geofísica nativa.",
    "copyright": "Copyright © Alejandro Pico",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
